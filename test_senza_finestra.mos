(!
  test_sigma_delta.mos
  --------------------
  Test parametrico senza sliding window: risolve il PDSP per ogni combinazione
  (k_turni, sigma, delta) e salva costo ottimo + statistiche su CSV.

  Limite licenza Community di Xpress: righe + colonne <= 5000.
  - Si calcola prima fino a quale delta il problema ci sta.
  - y(f,g,h) e i vincoli di linearizzazione (che NON dipendono da delta)
    vengono creati UNA SOLA VOLTA per tutte le coppie con pi < delta_max.
    Cambia solo l'obiettivo: i costi delta - pi(f,g) valgono 0 per le coppie
    non vicine, quindi il risultato e' identico ma il modello non si
    ricostruisce (e non accumula niente) a ogni delta.
  - Per i delta oltre il limite: banner e NA nel CSV.
!)

model "test"
  uses "mmxprs", "mmsystem"

declarations
    n_quartieri: integer
    n_farmacie: integer

    n_giorni = 30
    LIMITE   = 4900      ! limite licenza (5000) con un po' di margine
end-declarations

initializations from "datafile.dat"
    n_quartieri n_farmacie
end-initializations

declarations
    Q = 1..n_quartieri
    F = 1..n_farmacie
    H = 1..n_giorni

    t_dist: array(F, Q) of real
    pi_dist: array(F, F) of real

    copertura: array(Q, F) of integer
    costo: array(F, F) of real

    x: array(F, H) of mpvar
    y: dynamic array(F, F, H) of mpvar

    obiettivo: linctr

    VincoloCopertura: array(Q, H) of linctr
    VincoloTurniTotali: array(F) of linctr
    VincoloLinearizz: dynamic array(F, F, H) of linctr
end-declarations

initializations from "datafile.dat"
    t_dist pi_dist
end-initializations

declarations
    N_SIGMA = 50
    N_DELTA = 50
    N_K_TURNI = 30

    SIGMA_VALS : array(1..N_SIGMA) of real
    DELTA_VALS : array(1..N_DELTA) of real
    K_TURNI_VALS : array(1..N_K_TURNI) of integer

    sigma, delta, delta_max: real
    k_turni: integer
    is_infeasible: boolean

    costo_ottimo : real
    n_coppie     : integer
    n_coperti    : integer
    n_coppie_max : integer

    dim_stimata  : integer
    n_delta_ok   : integer
    trovato_limite: boolean
    n_saltati    : integer

    id_csv, id_soluzioni, id_console: integer
end-declarations

forall(i in 1..N_SIGMA) do
  SIGMA_VALS(i) := i * 0.1
  DELTA_VALS(i) := i * 0.1
end-do

forall(i in 1..N_K_TURNI) do
  K_TURNI_VALS(i) := 31 - i
end-do

id_console := getfid(F_OUTPUT)

fopen("risultati_test.csv", F_OUTPUT)
id_csv := getfid(F_OUTPUT)

fopen("soluzioni_test.txt", F_OUTPUT)
id_soluzioni := getfid(F_OUTPUT)

fselect(id_csv)
writeln("k_turni,sigma,delta,costo_ottimo,n_coppie_vicine,n_quartieri_coperti")

! =========================================================================
! Fino a quale delta si puo' arrivare con il limite della licenza?
! =========================================================================
n_delta_ok := 0
trovato_limite := false

forall(di in 1..N_DELTA) do
    n_coppie := 0
    forall(f in F, g in F | f < g)
        if pi_dist(f,g) < DELTA_VALS(di) then
            n_coppie += 1
        end-if

    dim_stimata := n_quartieri*n_giorni + n_farmacie + n_farmacie*n_giorni + 2*n_coppie*n_giorni

    if dim_stimata > LIMITE then
        trovato_limite := true
        break
    end-if
    n_delta_ok := di
end-do

fselect(id_console)
writeln("==========================================================")
writeln(" LIMITE LICENZA: righe + colonne <= ", LIMITE)
if n_delta_ok = 0 then
    writeln(" Nessun valore di delta rientra nel limite: nulla da risolvere.")
elif trovato_limite then
    writeln(" Risolvo per delta da ", DELTA_VALS(1), " a ", DELTA_VALS(n_delta_ok))
    writeln(" Per delta >= ", DELTA_VALS(n_delta_ok+1), " il problema e' troppo grande: NON risolvibile")
else
    writeln(" Tutti i valori di delta rientrano nel limite.")
end-if
writeln("==========================================================")

fselect(id_soluzioni)
writeln("Limite licenza: delta risolvibili = 1..", n_delta_ok, " su ", N_DELTA)

! =========================================================================
! Parte statica del modello, creata UNA volta sola
! =========================================================================
if n_delta_ok > 0 then
    delta_max := DELTA_VALS(n_delta_ok)

    n_coppie_max := 0
    forall(f in F, g in F | f < g)
        if pi_dist(f,g) < delta_max then
            n_coppie_max += 1
        end-if
    dim_stimata := n_quartieri*n_giorni + n_farmacie + n_farmacie*n_giorni + 2*n_coppie_max*n_giorni

    forall(f in F, h in H) x(f,h) is_binary

    ! y continua in [0,1]: con costi >= 0 e minimizzazione vale comunque 0/1
    forall(f, g in F, h in H | f < g and pi_dist(f,g) < delta_max) do
        create(y(f,g,h))
        y(f,g,h) <= 1
        VincoloLinearizz(f,g,h) := y(f,g,h) >= x(f,h) + x(g,h) - 1
    end-do
end-if

n_saltati := 0

! -----------------------------------------------------------------------
! TRIPLE LOOP: k_turni, sigma, delta
! -----------------------------------------------------------------------
forall(k in 1..N_K_TURNI) do
    forall(si in 1..N_SIGMA) do

        sigma := SIGMA_VALS(si)
        k_turni := K_TURNI_VALS(k)

        forall(q in Q, f in F)
            copertura(q,f) := if(t_dist(f,q) <= sigma, 1, 0)

        is_infeasible := false
        forall(q in Q) do
            if sum(f in F) copertura(q,f) = 0 then
                is_infeasible := true
                break
            end-if
        end-do

        if is_infeasible then
            fselect(id_soluzioni)
            writeln("k_turni = ", k_turni, ", sigma = ", sigma,
                    ": Infeasible per assenza copertura (tutti i delta). Salto.")
            next
        end-if

        ! Delta oltre il limite: banner e NA nel CSV
        if n_delta_ok < N_DELTA then
            fselect(id_console)
            writeln("********************************************************")
            writeln("* k_turni = ", k_turni, ", sigma = ", sigma)
            if n_delta_ok = 0 then
                writeln("* nessun delta risolvibile (limite licenza ", LIMITE, ")")
            else
                writeln("* delta da ", DELTA_VALS(n_delta_ok+1), " a ", DELTA_VALS(N_DELTA),
                        ": NON RISOLVIBILE (limite licenza ", LIMITE, ")")
            end-if
            writeln("********************************************************")

            fselect(id_soluzioni)
            writeln("k_turni = ", k_turni, ", sigma = ", sigma, ", delta da ",
                    DELTA_VALS(n_delta_ok+1), " a ", DELTA_VALS(N_DELTA),
                    ": NON RISOLTO (problema troppo grande per la licenza).")

            fselect(id_csv)
            forall(di in (n_delta_ok+1)..N_DELTA)
                writeln(k_turni, ",", sigma, ",", DELTA_VALS(di), ",NA,NA,NA")

            n_saltati += N_DELTA - n_delta_ok
        end-if

        if n_delta_ok = 0 then
            next
        end-if

        ! Vincoli che dipendono solo da (k_turni, sigma): ridefiniti una volta
        ! per coppia, non per ogni delta
        reset(VincoloCopertura)
        reset(VincoloTurniTotali)

        forall(q in Q, h in H) do
            VincoloCopertura(q,h) := sum(f in F | copertura(q,f) = 1) x(f,h) >= 1
        end-do

        forall(f in F) do
            VincoloTurniTotali(f) := sum(h in H) x(f,h) <= k_turni
        end-do

        forall(di in 1..n_delta_ok) do

            delta := DELTA_VALS(di)

            n_coppie := 0
            forall(f in F, g in F | f < g) do
                if pi_dist(f,g) < delta then
                    costo(f,g) := delta - pi_dist(f,g)
                    n_coppie += 1
                else
                    costo(f,g) := 0
                end-if
            end-do

            ! Cambia solo l'obiettivo
            obiettivo := sum(f, g in F, h in H | f < g and costo(f,g) > 0) (costo(f,g) * y(f,g,h))

            fselect(id_console)
            writeln("  -> k_turni=", k_turni, " sigma=", sigma, " delta=", delta,
                    " coppie=", n_coppie, " dimensione modello=", dim_stimata)

            minimize(obiettivo)

            if getprobstat <> XPRS_OPT then
                fselect(id_soluzioni)
                writeln("k_turni = ", k_turni, ", sigma = ", sigma, ", delta = ", delta,
                        ": Non ottimo/ammissibile dal solutore (stato ", getprobstat, "). Salto.")
                fselect(id_csv)
                writeln(k_turni, ",", sigma, ",", delta, ",NA,", n_coppie, ",NA")
                next
            end-if

            costo_ottimo := getobjval

            fselect(id_soluzioni)
            writeln("\n--- RISULTATI OTTIMIZZAZIONE k_turni = ", k_turni, ", sigma = ", sigma, ", delta = ", delta, " ---")
            writeln("Status soluzione: ", getprobstat)
            writeln("Costo totale: ", getobjval)

            forall(h in H) do
                write("Giorno ", h, "\t-> Farmacie aperte: ")
                forall(f in F) do
                    if getsol(x(f,h)) = 1 then
                        write("F", f, " ")
                    end-if
                end-do
                writeln("")
            end-do

            n_coperti := 0
            forall(q in Q) do
                if (sum(f in F) copertura(q,f) * getsol(x(f,1))) >= 1 then
                    n_coperti += 1
                end-if
            end-do

            fselect(id_csv)
            writeln(k_turni, ",", sigma, ",", delta, ",", costo_ottimo, ",", n_coppie, ",", n_coperti)

        end-do  ! fine loop delta
    end-do    ! fine loop sigma
end-do     ! fine loop k_turni

fclose(id_csv)
fclose(id_soluzioni)

fselect(id_console)
writeln("==========================================================")
writeln(" Esecuzione completata.")
writeln(" Combinazioni NON risolte per limite licenza: ", n_saltati)
writeln(" Risultati in risultati_test.csv (NA = non risolto)")
writeln("==========================================================")

end-model
