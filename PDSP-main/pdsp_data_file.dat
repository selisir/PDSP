! Data file for Pharmacy Duty Scheduling Problem (PDSP)
! Used for FICO Xpress Mosel

! --- PARAMETERS ---
! Number of days in the planning horizon
H: 7

! Number of neighborhoods (quartieri)
NUM_Q: 4

! Number of pharmacies (farmacie)
NUM_F: 3

! Maximum distance for a pharmacy to cover a neighborhood
SIGMA: 10

! Maximum distance between pharmacies to incur a penalty/cost
DELTA: 10

! Maximum number of shifts (k) allowed within a sliding window of days (s)
K: 2
S: 4

! --- MATRICES ---
! T_DIST: Distance between neighborhood q and pharmacy f
! Rows: Neighborhoods (1 to 4)
! Columns: Pharmacies (1 to 3)
T_DIST: [
     5 15 20
    15  4 12
    20 12  6
     8 15  9
]

! PI_DIST: Distance between pharmacy f and pharmacy g
! Rows and Columns: Pharmacies (1 to 3)
! Symmetric matrix with 0 on the diagonal
PI_DIST: [
     0 15  8
    15  0 12
     8 12  0
]