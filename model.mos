model "PDSP_Modello"
uses "mmxprs"

! =========================================================================
! BLOCCO 1: dimensioni e parametri scalari
! Devono essere dichiarati e CARICATI PRIMA di dichiarare qualunque array
! che dipenda da Q, F, H â€” altrimenti quegli array vengono creati con
! dimensione 0 e tutti i vincoli che li usano risultano vuoti/errati.
! =========================================================================
declarations
    n_quartieri: integer
    n_farmacie: integer
    n_giorni: integer

    sigma: real       ! Raggio massimo di copertura quartiere-farmacia
    delta: real       ! Raggio massimo di vicinanza farmacia-farmacia (penalitÃ )
    k_turni: integer  ! Numero massimo di turni consentiti...
    s_giorni: integer ! ...in una finestra di s giorni
                       ! NOTA: per il modello BASE (2 persone, vincolo "non piu'
                       ! di k turni in tutto H") impostare s_giorni = n_giorni:
                       ! la sliding window collassa a un'unica finestra pari
                       ! all'intero orizzonte, cioe' sum(h in H) x(f,h) <= k_turni.
                       ! Per la VARIANTE 2 (3 persone) impostare s_giorni < n_giorni.
end-declarations

initializations from "datafile.dat"
    n_quartieri n_farmacie n_giorni
    sigma delta k_turni s_giorni
end-initializations

! =========================================================================
! BLOCCO 2: insiemi e strutture dati che dipendono dalle dimensioni sopra
! Ora Q, F, H hanno gia' un valore -> gli array vengono dimensionati bene.
! =========================================================================
declarations
    Q = 1..n_quartieri
    F = 1..n_farmacie
    H = 1..n_giorni

    t_dist: array(Q, F) of real   ! distanza t_{qf} tra quartiere e farmacia
    pi_dist: array(F, F) of real  ! distanza pi_{fg} tra farmacia e farmacia

    copertura: array(Q, F) of integer  ! 1 se t(q,f) <= sigma, 0 altrimenti
    costo: array(F, F) of real         ! delta - pi(f,g) se < delta, 0 altrimenti

    x: array(F, H) of mpvar            ! x(f,h)=1 se farmacia f e' di turno il giorno h
    y: dynamic array(F, F, H) of mpvar ! variabile di linearizzazione
end-declarations

initializations from "datafile.dat"
    t_dist pi_dist
end-initializations

! Controllo di coerenza sul parametro s_giorni (errore comune)
if s_giorni > n_giorni then
    writeln("ERRORE: s_giorni non puo' essere maggiore di n_giorni")
    exit(1)
end-if

! --- PRECALCOLO PARAMETRI ---

! 1. Matrice di copertura
forall(q in Q, f in F) do
    if t_dist(q,f) <= sigma then
        copertura(q,f) := 1
    else
        copertura(q,f) := 0
    end-if
end-do

! 2. Matrice dei costi (solo f < g, la coppia non ordinata si conta una volta sola)
forall(f, g in F | f < g) do
    if pi_dist(f,g) <= delta then
        costo(f,g) := delta - pi_dist(f,g)
    else
        costo(f,g) := 0.0
    end-if
end-do

! --- STAMPA COPPIE DI FARMACIE CON COSTO > 0 ---
writeln("\n--- COPPIE CON PENALITA' DI VICINANZA (costo > 0) ---")
n_coppie := 0

forall(f, g in F | f < g and costo(f,g) > 0) do
    writeln("Coppia (F", f, ", F", g, ") -> Distanza: ", pi_dist(f,g), " km | Costo: ", costo(f,g))
    n_coppie += 1
end-do

if n_coppie = 0 then
    writeln("Nessuna coppia di farmacie si trova a distanza inferiore a delta (", delta, " km).")
end-if

! --- VARIABILI E DOMINI ---

forall(f in F, h in H) x(f,h) is_binary

! Creazione dinamica delle y solo per le coppie che generano costo > 0
forall(f, g in F, h in H | f < g and costo(f,g) > 0) do
    create(y(f,g,h))
    y(f,g,h) is_binary
end-do

! --- VINCOLI ---

! 1. Copertura: ogni quartiere q, ogni giorno h, deve avere >= 1 farmacia
!    aperta tra quelle che lo coprono (copertura(q,f)=1)
forall(q in Q, h in H) do
    sum(f in F | copertura(q,f) = 1) x(f,h) >= 1
end-do

! 2. Turnistica (sliding window): al massimo k_turni turni in ogni finestra
!    di s_giorni consecutivi. Con s_giorni = n_giorni si ottiene il vincolo
!    "totale" del modello base, con s_giorni < n_giorni si ottiene
!    la Variante 2.
!forall(f in F, inizio in 1..(n_giorni - s_giorni + 1)) do
!    sum(h in inizio..(inizio + s_giorni - 1)) x(f,h) <= k_turni
!end-do

! 2. Turnistica globale: al massimo k_turni per ciascuna farmacia nell'intero orizzonte H
forall(f in F) do
    sum(h in H) x(f,h) <= k_turni
end-do

! 3. Linearizzazione AND: y(f,g,h) >= 1 solo se f e g sono ENTRAMBE aperte
!    lo stesso giorno h. Essendo costo(f,g) > 0 e la funzione obiettivo una
!    minimizzazione, y viene spinta a 0 quando non e' forzata: non serve
!    un vincolo di upper bound separato.
forall(f, g in F, h in H | f < g and costo(f,g) > 0) do
    y(f,g,h) >= x(f,h) + x(g,h) - 1
end-do

! --- FUNZIONE OBIETTIVO ---
F_Obiettivo := sum(f, g in F, h in H | f < g and costo(f,g) > 0) (costo(f,g) * y(f,g,h))

minimize(F_Obiettivo)

! --- STAMPA COPERTURA QUARTIERI ---
writeln("\n--- COPERTURA PER QUARTIERE ---")
forall(q in Q) do
    write("Q", q, " -> ")
    n_aperte := 0
    forall(f in F | copertura(q,f) = 1) do
        if n_aperte > 0 then
            write(", ")
        end-if
        write("F", f)
        n_aperte += 1
    end-do
    writeln("")
end-do

! --- STAMPA RISULTATI ---
writeln("\n--- RISULTATI OTTIMIZZAZIONE ---")
writeln("Status Soluzione: ", getprobstat)
writeln("Costo Totale (Funzione Obiettivo): ", getobjval)
writeln("")

forall(h in H) do
    write("Giorno ", h, " -> Farmacie aperte: ")
    forall(f in F) do
        if getsol(x(f,h)) > 0.5 then
            write("F", f, " ")
        end-if
    end-do
    writeln("")
end-do

end-model
