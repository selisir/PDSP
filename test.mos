(!
  test_sigma_delta.mos
  --------------------
  Test parametrico: risolve il PDSP per ogni combinazione
  (sigma, delta) e salva costo ottimo + statistiche su CSV.

  Sigma: raggio copertura quartiere-farmacia  (t_qf <= sigma)
  Delta: soglia distanza tra farmacie         (pi_fg < delta ? coppia vicina)
!)

model "test"
  uses "mmxprs", "mmsystem"

! inizializzazioni da modello da testare (modello base)
! =========================================================================
! BLOCCO 1: dimensioni e parametri
! =========================================================================
declarations
    n_quartieri: integer
    n_farmacie: integer
    n_giorni: integer ! Giorni totali

    k_turni: integer  ! Numero massimo di turni consentiti
    
    s_giorni: integer ! Finestra sliding window
    s_turni: integer  ! Numero turni massimi per sliding window
                       
end-declarations

initializations from "datafile.dat"
    n_quartieri n_farmacie n_giorni
    k_turni s_giorni s_turni
end-initializations

! =========================================================================
! BLOCCO 2: insiemi e strutture dati
! =========================================================================
declarations
    Q = 1..n_quartieri
    F = 1..n_farmacie
    H = 1..n_giorni

    t_dist: array(F, Q) of real   ! distanza t_{fq} tra quartiere e farmacia
    pi_dist: array(F, F) of real  ! distanza pi_{fg} tra farmacia e farmacia

    copertura: array(Q, F) of integer  ! 1 se t(f,q) <= sigma, 0 altrimenti
    costo: array(F, F) of real         ! delta - pi(f,g) se pi(f,g) e' < delta, 0 altrimenti

    x: array(F, H) of mpvar            ! x(f,h)=1 se farmacia f e' di turno il giorno h
    y: dynamic array(F, F, H) of mpvar ! variabile di linearizzazione
end-declarations

initializations from "datafile.dat"
    t_dist pi_dist
end-initializations

declarations
	! Griglia di test per sigma e delta
    (!N_SIGMA = 5
    N_DELTA = 5!)
    N_SIGMA = 1
    N_DELTA = 1

    SIGMA_VALS : array(1..N_SIGMA) of real
    DELTA_VALS : array(1..N_DELTA) of real

    ! Indici di scorrimento (dichiarati qui, MAI dentro forall)
    si : integer
    di : integer

    ! Variabili per risultati del singolo run
    costo_ottimo : real
    n_coppie     : integer
    n_coperti    : integer

    fo : integer
end-declarations

obiettivo := sum(f, g in F, h in H | f < g and costo(f,g) > 0) (costo(f,g) * y(f,g,h))

! Valori della griglia (modifica secondo il tuo dominio)
(!SIGMA_VALS(1) := 0.8  ; SIGMA_VALS(2) := 1.0  ; SIGMA_VALS(3) := 1.2
SIGMA_VALS(4) := 1.5  ; SIGMA_VALS(5) := 2.0

DELTA_VALS(1) := 0.5  ; DELTA_VALS(2) := 0.8  ; DELTA_VALS(3) := 1.0
DELTA_VALS(4) := 1.2  ; DELTA_VALS(5) := 1.5!)

! test a casa
SIGMA_VALS(1) := 2.0
DELTA_VALS(1) := 1.0


! Apri CSV di output
fo := fopen("risultati_test.csv", F_OUTPUT)
fwriteln(fo, "sigma,delta,costo_ottimo,n_coppie_vicine,n_quartieri_coperti")

! -----------------------------------------------------------------------
! DOPPIO LOOP: sigma fisso, delta scorre; poi sigma avanza
! -----------------------------------------------------------------------
forall(si in 1..N_SIGMA) do
    forall(di in 1..N_DELTA) do

        ! 1. Aggiorna parametri globali usati dal modello
        sigma := SIGMA_VALS(si)
        delta := DELTA_VALS(di)

        ! 2. Ricalcola C(q) e costi c_fg con i nuovi sigma/delta
        !    (chiama la tua procedura di precalcolo oppure inline)
        forall(q in 1..N_Q, f in 1..N_F)
            copertura(q,f) := if(t(q,f) <= sigma, 1, 0)

        n_coppie := 0
        forall(f in 1..N_F, g in f+1..N_F) do
            if pi(f,g) < delta then
                c(f,g)   := delta - pi(f,g)
                n_coppie += 1
            else
                c(f,g) := 0
            end-if
        end-do

        forall(f in F, h in H) x(f,h) is_binary

        ! Creazione delle y per le coppie che generano costo > 0
        forall(f, g in F, h in H | f < g and costo(f,g) > 0) do
        create(y(f,g,h))
        y(f,g,h) is_binary
        end-do

        ! 4. Risolvi
        minimize(obiettivo)
        costo_ottimo := getobjval

        ! 5. Conta quartieri effettivamente coperti
        n_coperti := 0
        forall(q in 1..N_Q) do
          if getsol(sum(f in 1..N_F) copertura(q,f) * x(f,1)) >= 1 then
            n_coperti += 1
          end-if
        end-do

        ! 6. Scrivi riga CSV
        fwriteln(fo,
          string(sigma)       + "," +
          string(delta)       + "," +
          string(costo_ottimo) + "," +
          string(n_coppie)    + "," +
          string(n_coperti)
        )

        writeln("sigma=", sigma, "  delta=", delta,
                "  costo=", costo_ottimo,
                "  coppie=", n_coppie)

    end-do  ! fine loop delta
end-do    ! fine loop sigma

fclose(fo)
writeln("Fine. Risultati in: risultati_test.csv")

end-model
